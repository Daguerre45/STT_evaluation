# GPU para faster-whisper. Usa float16 en una RTX 5070; prueba int8_float16 si falta VRAM.
TTS_EVAL_DEVICE=cuda
TTS_EVAL_COMPUTE_TYPE=float16
TTS_EVAL_WHISPER_MODEL=turbo

# Ruta al binario ffmpeg. Si esta en PATH, deja el valor por defecto.
TTS_EVAL_FFMPEG_BIN=ffmpeg

# Umbrales de pausas entre palabras, en segundos.
TTS_EVAL_MIN_PAUSE_SECONDS=0.15
TTS_EVAL_BRIEF_PAUSE_SECONDS=0.25
TTS_EVAL_LONG_PAUSE_SECONDS=0.70
TTS_EVAL_MISPLACED_PAUSE_SECONDS=0.45

# Opcional: activa alineamiento de Montreal Forced Aligner.
TTS_EVAL_MFA_ENABLED=false
TTS_EVAL_MFA_COMMAND=mfa
TTS_EVAL_MFA_PTPT_ACOUSTIC_MODEL=
TTS_EVAL_MFA_PTPT_DICTIONARY=
TTS_EVAL_MFA_ESES_ACOUSTIC_MODEL=
TTS_EVAL_MFA_ESES_DICTIONARY=

# Opcional: informe redactado por un Qwen local servido por Ollama.
TTS_EVAL_OLLAMA_ENABLED=false
TTS_EVAL_OLLAMA_BASE_URL=http://127.0.0.1:11434
TTS_EVAL_OLLAMA_MODEL=qwen3:4b

# Deteccion de anomalias perceptuales (auditoria humana automatica)
TTS_EVAL_LOW_CONFIDENCE_THRESHOLD=0.60
TTS_EVAL_PITCH_JUMP_THRESHOLD_SEMITONES=6.0
TTS_EVAL_RUSHED_SYLLABLE_RATE=12.0
TTS_EVAL_STRETCHED_SYLLABLE_RATE=1.8

# Evaluacion perceptual neuronal TorchAudio SQUIM (MOS subjetivo, PESQ, STOI)
TTS_EVAL_SQUIM_ENABLED=false

